{
  "name": "mewhelp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MewHelp 智能客服前端（React + Vite）。构建产物输出到 src/mewhelp/api/static，由 FastAPI 直接服务，运行时不依赖 Node。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
