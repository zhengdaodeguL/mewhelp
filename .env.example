# ============================================================
# MewHelp 配置模板。复制为 .env 后按需修改。
#
# 默认全套 mock：不装 Docker、不配 API Key 也能把整条流水线跑通。
# 要切真栈，把 *_MODE 改成对应值即可，代码路径完全一致。
# ============================================================

# ---------- LLM ----------
# mock  = 内置确定性规则实现（默认，零依赖，测试可复现）
# openai= 任何 OpenAI 兼容端点
MEWHELP_LLM_MODE=mock
MEWHELP_LLM_MODEL=gpt-5-mini
# 下面两个为空时自动回落到环境变量 OPENAI_API_KEY / OPENAI_BASE_URL
MEWHELP_OPENAI_API_KEY=
MEWHELP_OPENAI_BASE_URL=

# ---------- Embedding ----------
# mock = 确定性哈希向量（无需下载模型）
# bge  = BAAI/bge-m3（需 pip install -e ".[bge]"）
MEWHELP_EMBEDDING_MODE=mock
MEWHELP_EMBEDDING_MODEL=BAAI/bge-m3
MEWHELP_EMBEDDING_DIM=1024

# ---------- Reranker ----------
# mock = 词面重叠打分；bge = BAAI/bge-reranker-v2-m3
MEWHELP_RERANKER_MODE=mock
MEWHELP_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 存储 ----------
# memory = 进程内 numpy 索引 + SQLite（默认）
# milvus = 真实 Milvus（docker compose up -d）
MEWHELP_VECTOR_STORE_MODE=memory
MEWHELP_MILVUS_URI=http://localhost:19530
MEWHELP_MILVUS_COLLECTION=mewhelp_kb
# memory 模式可用 sqlite:///./mewhelp.db，milvus 模式建议 mysql+pymysql://...
MEWHELP_DATABASE_URL=sqlite:///./mewhelp.db

# ---------- 检索参数 ----------
MEWHELP_DENSE_TOP_K=20
MEWHELP_SPARSE_TOP_K=20
MEWHELP_FUSION_TOP_K=10
MEWHELP_RERANK_TOP_K=5
MEWHELP_RRF_K=60

# ---------- 置信度闸门 ----------
MEWHELP_CONFIDENCE_THRESHOLD=0.35

# ---------- 会话上下文 ----------
MEWHELP_WINDOW_TURNS=3
MEWHELP_SUMMARY_TRIGGER_TOKENS=2000

# ---------- 可观测 ----------
MEWHELP_LANGFUSE_ENABLED=false
MEWHELP_LANGFUSE_PUBLIC_KEY=
MEWHELP_LANGFUSE_SECRET_KEY=
MEWHELP_LANGFUSE_HOST=http://localhost:3001
